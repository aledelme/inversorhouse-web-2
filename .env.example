# ---------------------------------------------------------------------------
# InversorHouse — environment variables
#
# Local development: copy this file to `.env.development.local` (used by
# `pnpm dev`) and to `.env.production.local` (used by `pnpm prod:local`).
# The defaults below point at the Docker services in docker/compose.yml.
#
# Production values live in Vercel → Project → Settings → Environment Variables.
# NEVER put production credentials in a local .env file.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3020

# --- Database (Postgres) ------------------------------------------------------
# Local Docker database. In Vercel the Neon integration sets DATABASE_URL.
DATABASE_URL=postgres://inversorhouse:inversorhouse@localhost:5442/inversorhouse_dev

# --- Auth (Clerk) ------------------------------------------------------------
# Use the keys of the Clerk *development* instance (pk_test_/sk_test_) locally.
# If left empty, `pnpm dev` runs Clerk in keyless mode with temporary keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated list of emails that can access /admin (must be verified in Clerk).
ADMIN_EMAILS=

# --- Storage (Cloudflare R2 / local MinIO) ----------------------------------
# Public base URL where photos are served from (no trailing slash).
NEXT_PUBLIC_R2_CLOUDFLARE_URL=http://localhost:9010/inversorhouse-public
# Only set locally: S3 endpoint of MinIO. In production it is derived from R2_ACCOUNT_ID.
R2_ENDPOINT=http://localhost:9010
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=inversorhouse
R2_SECRET_ACCESS_KEY=inversorhouse-secret
R2_PUBLIC_BUCKET=inversorhouse-public
R2_PRIVATE_BUCKET=inversorhouse-private

# --- Dormant integrations (kept for the future, not used by v2) -------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
